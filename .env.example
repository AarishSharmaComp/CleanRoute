# Compose requires a locally chosen, non-empty PostgreSQL password.
POSTGRES_DB=cleanroute
POSTGRES_USER=cleanroute
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080
# Development-only random signing key (at least 32 bytes); replace for deployments.
JWT_SECRET=change-this-development-only-secret-to-a-random-32-byte-value
# Optional future provider credentials; mocks run without these.
AQI_API_KEY=
WEATHER_API_KEY=
TRAFFIC_API_KEY=
# Observation ingestion runs every 15 minutes by default.
OBSERVATION_INGESTION_INTERVAL_MS=900000
OBSERVATION_PROVIDER_TIMEOUT_MS=5000
OBSERVATION_RATE_LIMIT_BACKOFF_MS=60000
