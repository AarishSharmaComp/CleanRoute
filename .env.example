# Compose requires a locally chosen, non-empty PostgreSQL password.
POSTGRES_DB=cleanroute
POSTGRES_USER=cleanroute
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080
GEOCODING_PROVIDER=photon
PHOTON_API_URL=https://photon.komoot.io/api/
GEOCODING_CONNECT_TIMEOUT_MS=2000
GEOCODING_READ_TIMEOUT_MS=5000
GEOCODING_COVERAGE_RADIUS_METERS=35000
ROUTING_PROVIDER=mock
OSRM_API_URL=https://router.project-osrm.org
ROUTING_CONNECT_TIMEOUT_MS=2000
ROUTING_READ_TIMEOUT_MS=5000
ROUTING_MAX_GEOMETRY_POINTS=5000
ENVIRONMENTAL_PROVIDER=mock
OPEN_METEO_API_URL=https://air-quality-api.open-meteo.com/v1/air-quality
ENVIRONMENTAL_CONNECT_TIMEOUT_MS=2000
ENVIRONMENTAL_READ_TIMEOUT_MS=5000
ENVIRONMENTAL_ROUTE_SAMPLE_INTERVAL_METERS=1000
# Development-only random signing key (at least 32 bytes); replace for deployments.
JWT_SECRET=change-this-development-only-secret-to-a-random-32-byte-value
# Observation ingestion runs every 15 minutes by default.
OBSERVATION_INGESTION_INTERVAL_MS=900000
OBSERVATION_PROVIDER_TIMEOUT_MS=5000
OBSERVATION_RATE_LIMIT_BACKOFF_MS=60000
